# --- Never commit large binaries: footage, weights, venv, outputs ---

# Python environment
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Vendored upstream source (re-fetched by scripts/download.sh)
vendor/

# Model weights
checkpoints/
*.pt
*.pth
*.safetensors

# Footage: source movie and extracted frame folders.
# The tiny sidecars that make a shot reproducible ARE committed: shot.json records the
# exact ffmpeg cut, point.json records the clicks. Git cannot re-include a file whose
# parent directory is excluded, so the directories are re-admitted before the files.
shots/*
!shots/.gitkeep
!shots/*/
shots/*/*
!shots/*/shot.json
!shots/*/point.json

# Generated mattes, RGBA sequences, comps
outputs/*
!outputs/.gitkeep

# Media formats, wherever they land
*.mov
*.mp4
*.webm
*.mkv
*.zip
*.exr

# macOS
.DS_Store
